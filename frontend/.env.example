# PharmaSafe Frontend Environment Configuration
# Copy this to .env and adjust for your setup

# Backend API URL — point to your running FastAPI backend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Set to true to use mock data instead of the real API (for offline demo)
VITE_USE_MOCK_DATA=false

# App metadata
VITE_APP_NAME=PharmaSafe Intelligence
VITE_APP_VERSION=3.0.0
