# PharmaSafe Intelligence — Environment Configuration
# Copy this to .env and fill in real values. Never commit .env to git.

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="PharmaSafe Intelligence"
API_V1_STR="/api/v1"

# ── Security & JWT ─────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite (dev only):
# DATABASE_URL=sqlite:///./pharmasafe.db
# Render PostgreSQL (auto-injected by render.yaml — do not change):
DATABASE_URL=postgresql://pharmasafe_user:password@host/pharmasafe

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set this to your Render frontend URL after first deploy e.g.:
# FRONTEND_URL=https://pharmasafe-web.onrender.com
FRONTEND_URL=

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_DIR="./storage"
PHOTO_UPLOAD_DIR="./storage/photos"
CERTIFICATE_DIR="./storage/certificates"
EVIDENCE_DIR="./storage/evidence"

# ── AI Engine Thresholds ───────────────────────────────────────────────────────
AI_EXPIRY_RISK_THRESHOLD=0.75
AI_ANOMALY_SENSITIVITY=0.80
AI_REENTRY_CRITICAL_THRESHOLD=0.85
